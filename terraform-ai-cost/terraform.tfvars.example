# Copy to terraform.tfvars and edit before `terraform apply`.

aws_profile           = "mgt"
management_account_id = "660571558619"

# Real recipients for AI budget overrun alerts (required).
notify_emails = ["finops@dynmedia.com"]

# Monthly AI budget ceiling in USD. Current AI run-rate ~ $2,100/mo.
budget_limit_amount = "3000"

# Lowercase standard keys to activate as cost allocation tags (only keys that
# Billing has already seen on a resource; see variables.tf).
cost_allocation_tag_keys = [
  "owner", "environment", "project", "team", "product",
]

# Alert thresholds
actual_thresholds_percent     = [80, 100]
forecasted_thresholds_percent = [100]

# pipeline trigger: 2026-09-28T06:40:20Z
